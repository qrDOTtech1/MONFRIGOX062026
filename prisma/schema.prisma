generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum Difficulty {
  FACILE
  MOYEN
  DIFFICILE
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  password        String
  role            Role      @default(USER)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  // Préférences alimentaires
  allergens       String    @default("")  // JSON array: ["gluten","lactose",...]
  dietMode        String    @default("")  // vegan, vegetarien, halal, casher, sans-porc, ""
  kidMode         String    @default("")  // "", "enfant", "bebe"
  kidAgeMonths    Int?
  defaultServings Int       @default(4)
  // Goûts & onboarding
  tasteProfile     String    @default("")
  equipment        String    @default("")  // JSON array: ["four","micro-ondes","air-fryer",...]
  onboardingDone   Boolean   @default(false)
  // Abonnement & facturation
  plan             String    @default("FREE")   // FREE | PREMIUM | VIP
  planExpiresAt    DateTime?
  stripeCustomerId String?   @unique
  extraQuota       Int       @default(0)        // requêtes IA bonus achetées
  // Compteurs IA (reset quotidien/mensuel)
  aiCallsToday     Int       @default(0)
  aiCallsTodayDate String    @default("")       // YYYY-MM-DD
  aiCallsMonth     Int       @default(0)
  aiCallsMonthDate String    @default("")       // YYYY-MM
  revisitCount     Int       @default(0)        // compteur revisites IA semaine
  revisitWeek      String    @default("")       // YYYY-Www
  // Notifications
  notifyExpiry     Boolean   @default(true)      // alerte aliments qui périment
  notifyMeals      Boolean   @default(true)      // rappel repas du jour non planifié
  fridgeItems      FridgeItem[]
  favorites       Favorite[]
  shoppingLists   ShoppingList[]
  mealPlans       MealPlan[]
  recipeNotes     RecipeNote[]
  noteLikes       RecipeNoteLike[]
  cookLogs        CookLog[]
  badges          Badge[]
  recipes         Recipe[]         @relation("UserRecipes")
  coachProfile    CoachProfile?
  supplements     Supplement[]
  collections     Collection[]
  pushSubs        PushSubscription[]
  promoUses       PromoUse[]
}

model Ingredient {
  id          String   @id @default(cuid())
  name        String   @unique
  category    String
  emoji       String   @default("")
  imageUrl    String   @default("")
  brands      String   @default("")
  barcode     String   @default("")
  // Valeurs nutritionnelles pour 100g (depuis Open Food Facts EAN scan)
  kcal        Float?
  protein     Float?
  fat         Float?
  carbs       Float?
  fiber       Float?
  salt        Float?
  // Micronutriments pour 100g
  iron        Float?   // mg — fer
  magnesium   Float?   // mg
  calcium     Float?   // mg
  potassium   Float?   // mg
  zinc        Float?   // mg
  vitaminC    Float?   // mg
  vitaminD    Float?   // µg
  vitaminB12  Float?   // µg
  vitaminB9   Float?   // µg — acide folique
  omega3      Float?   // g
  phosphorus  Float?   // mg
  selenium    Float?   // µg
  iodine      Float?   // µg
  nutriScore  String   @default("")
  fridgeItems FridgeItem[]
  recipeIngredients RecipeIngredient[]
  shoppingItems ShoppingItem[]
}

model FridgeItem {
  id           String     @id @default(cuid())
  userId       String
  ingredientId String
  quantity     Float      @default(1)
  unit         String     @default("unité")
  expiresAt    DateTime?
  addedAt      DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([userId, ingredientId])
}

model Recipe {
  id           String    @id @default(cuid())
  name         String
  description  String
  instructions String
  difficulty   Difficulty
  prepTime     Int
  cuisine      String
  imageUrl     String    @default("")
  servings     Int       @default(4)
  // Nutrition par portion
  calories     Int?
  protein      Float?
  fat          Float?
  carbs        Float?
  fiber        Float?
  salt         Float?
  nutriScore   String    @default("")
  // Notation moyenne
  avgRating    Float     @default(0)
  ratingCount  Int       @default(0)
  // Source externe
  externalId   String?
  externalSrc  String    @default("")
  // Catégories spéciales
  kidFriendly  Boolean   @default(false)
  babyFriendly Boolean   @default(false)
  // Revisite : recette dérivée d'une autre via l'IA
  isRevisite   Boolean   @default(false)
  revisitOf    String?   // id de la recette d'origine
  // Recette partagée par un utilisateur (communauté)
  authorId     String?   // null = recette officielle/seed
  author       User?     @relation("UserRecipes", fields: [authorId], references: [id], onDelete: SetNull)
  isPublic     Boolean   @default(false)  // partagée publiquement dans la communauté
  createdAt    DateTime  @default(now())
  ingredients  RecipeIngredient[]
  favorites    Favorite[]
  mealPlans    MealPlan[]
  notes        RecipeNote[]
  cookLogs     CookLog[]
  collections  CollectionRecipe[]
}

model RecipeIngredient {
  id           String     @id @default(cuid())
  recipeId     String
  ingredientId String
  quantity     Float
  unit         String
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([recipeId, ingredientId])
}

model Favorite {
  id       String @id @default(cuid())
  userId   String
  recipeId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
}

model ShoppingList {
  id         String         @id @default(cuid())
  userId     String
  name       String
  shareToken String?        @unique
  createdAt  DateTime       @default(now())
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      ShoppingItem[]
}

model ShoppingItem {
  id           String       @id @default(cuid())
  listId       String
  ingredientId String
  quantity     Float
  unit         String
  checked      Boolean      @default(false)
  list         ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  ingredient   Ingredient   @relation(fields: [ingredientId], references: [id])
}

model MealPlan {
  id       String   @id @default(cuid())
  userId   String
  recipeId String
  date     DateTime
  mealType MealType
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe   Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, date, mealType])
}

model RecipeNote {
  id        String   @id @default(cuid())
  userId    String
  recipeId  String
  content   String   @default("")
  photoUrl  String   @default("") @db.Text
  isPublic  Boolean  @default(false)
  likeCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  likes     RecipeNoteLike[]

  @@unique([userId, recipeId])
}

model RecipeNoteLike {
  id        String     @id @default(cuid())
  userId    String
  noteId    String
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  note      RecipeNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  @@unique([userId, noteId])
}

model CookLog {
  id       String   @id @default(cuid())
  userId   String
  recipeId String
  cookedAt DateTime @default(now())
  servings Int      @default(4)
  rating   Int?     // 1-5 étoiles
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe   Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model Badge {
  id        String   @id @default(cuid())
  userId    String
  code      String   // ex: "cook_10", "anti_gaspi_5"
  unlockedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, code])
}

model AppConfig {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

// ── Carnets / collections de recettes ─────────────────────────────────
model Collection {
  id        String             @id @default(cuid())
  userId    String
  name      String
  emoji     String             @default("📁")
  createdAt DateTime           @default(now())
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipes   CollectionRecipe[]
}

model CollectionRecipe {
  id           String     @id @default(cuid())
  collectionId String
  recipeId     String
  addedAt      DateTime   @default(now())
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([collectionId, recipeId])
}

// ── Abonnement Web Push (notifications) ───────────────────────────────
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique @db.Text
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Coach IA personnel (VIP) ──────────────────────────────────────────
model CoachProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  // Profil physique (optionnel)
  height          Int?     // cm
  weight          Float?   // kg
  age             Int?
  sex             String?  // M / F / other
  // Activité & mode de vie
  activityLevel   String   @default("moderate") // sedentary, light, moderate, active, very_active
  sportTypes      String   @default("[]")       // JSON: ["running","musculation",...]
  sportFrequency  Int?                           // sessions par semaine
  // Objectifs
  goal            String   @default("maintain")  // maintain, lose, gain, energy, health
  targetCalories  Int?                           // override TDEE si défini manuellement
  // Contraintes horaires (JSON)
  schedule        String   @default("{}")        // {"breakfast":"7h30","lunch":"12h30","dinner":"20h","busyDays":["mercredi"]}
  // Calculé
  tdee            Int?     // Total Daily Energy Expenditure
  bmr             Int?     // Basal Metabolic Rate
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Supplement {
  id        String   @id @default(cuid())
  userId    String
  name      String   // ex: "Fer", "Vitamine D", "Whey Protein"
  dosage    String   @default("")  // ex: "14mg", "1000 UI", "30g"
  timing    String   @default("morning") // morning, noon, evening, pre_workout, post_workout
  category  String   @default("")  // vitamin, mineral, protein, amino, omega, other
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PromoCode {
  id                String    @id @default(cuid())
  code              String    @unique
  description       String    @default("")
  planGranted       String    // PREMIUM | VIP
  durationMonths    Int       @default(1)
  maxUses           Int?      // null = illimité
  usedCount         Int       @default(0)
  expiresAt         DateTime?
  isActive          Boolean   @default(true)
  // Conditions d'utilisation
  firstSignupOnly   Boolean   @default(false)  // jamais eu de plan payant
  minAccountAgeDays Int?      // compte doit avoir au moins X jours
  maxAccountAgeDays Int?      // compte doit avoir au plus X jours (nouveau compte)
  createdAt         DateTime  @default(now())
  uses              PromoUse[]
}

model PromoUse {
  id        String    @id @default(cuid())
  promoId   String
  userId    String
  usedAt    DateTime  @default(now())
  promo     PromoCode @relation(fields: [promoId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([promoId, userId])
  @@index([userId])
}
