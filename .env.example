# Database (Railway PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/monfrigo

# Auth
JWT_SECRET=change-me-to-a-random-string

# Admin credentials (first user with this email gets ADMIN role)
ADMIN_EMAIL=admin@monfrigo.app
ADMIN_PASSWORD=change-me

# AI API (OpenAI-compatible: Together, Groq, Ollama, etc.)
OLLAMA_API_URL=https://api.together.xyz/v1
OLLAMA_API_KEY=your-api-key
OLLAMA_MODEL=meta-llama/Llama-3-70b-chat-hf
OLLAMA_VISION_MODEL=meta-llama/Llama-4-Scout-17B-16E-Instruct

# Backup AI API (optional)
OLLAMA_BACKUP_API_URL=
OLLAMA_BACKUP_API_KEY=
