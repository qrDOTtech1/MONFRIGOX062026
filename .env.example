# Database (Railway PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/monfrigo

# Auth
JWT_SECRET=change-me-to-a-random-string

# Admin credentials (first user with this email gets ADMIN role)
ADMIN_EMAIL=admin@monfrigo.app
ADMIN_PASSWORD=change-me

# Ollama Cloud config is managed entirely from the Admin Portal
# No env vars needed — go to /admin/config after first login
