# ─────────────────────────────────────────────────────────────
#  Variables d'environnement (à définir dans Railway → Variables)
#  Les clés API IA / Stripe Price IDs se gèrent dans l'admin (voir bas du fichier).
# ─────────────────────────────────────────────────────────────

# === Base de données (Railway PostgreSQL) — OBLIGATOIRE ===
DATABASE_URL=postgresql://user:password@host:5432/railway

# === Auth — OBLIGATOIRE en production ===
# Chaîne aléatoire longue (32+ caractères). ⚠️ Sans ça, un secret par défaut
# CONNU est utilisé → n'importe qui pourrait forger une session. À NE PAS oublier.
# Générer : openssl rand -base64 48
JWT_SECRET=

# === Admin — OBLIGATOIRE ===
# Le 1er compte créé (inscription) avec cet email obtient le rôle ADMIN.
ADMIN_EMAIL=ton-email@exemple.com

# === URL publique de l'app — recommandé ===
# Utilisée pour les redirections Stripe, le sitemap, les liens partagés.
NEXT_PUBLIC_APP_URL=https://ton-domaine.up.railway.app

# === Stripe (paiements) — requis pour activer les paiements ===
# Clés : https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_xxx
# Secret du webhook (Dashboard → Developers → Webhooks → ton endpoint → Signing secret)
# Peut aussi être renseigné dans /admin/billing (clé "stripe_webhook_secret").
STRIPE_WEBHOOK_SECRET=whsec_xxx

# === Notifications push (cron externe) — optionnel ===
# Protège POST /api/notifications/run?secret=... Le scheduler INTERNE tourne déjà
# (9h expiry, 17h30 repas). À ne renseigner que si tu ajoutes un cron externe.
CRON_SECRET=

# === SEO — optionnel ===
GOOGLE_SITE_VERIFICATION=

# ─────────────────────────────────────────────────────────────
#  Géré dans l'ADMIN (stocké en base, PAS en variables d'env) :
#   • IA Ollama (host, clé, modèles)      → /admin/config
#   • Spoonacular / USDA (imports)        → /admin/config
#   • Stripe Price IDs + prix affichés    → /admin/billing
#   • Secret webhook Stripe (alternative) → /admin/billing
#
#  i18n / traductions : AUCUNE clé requise (endpoint Google gratuit).
# ─────────────────────────────────────────────────────────────
